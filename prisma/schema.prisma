// Joylinks IT akademiyasi — ma'lumotlar bazasi sxemasi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseFormat {
  OFFLINE
  ONLINE
  HYBRID
}

enum ApplicationStatus {
  NEW
  CONTACTED
  ENROLLED
  REJECTED
}

// ─────────────────────────────────────────────
// Admin
// ─────────────────────────────────────────────

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Kurslar va mentorlar
// ─────────────────────────────────────────────

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  shortDescription String
  description      String
  image            String?
  icon             String       @default("code")
  color            String       @default("#0eb182")
  durationMonths   Int
  lessonsPerWeek   Int          @default(3)
  lessonHours      Int          @default(2)
  price            Int
  oldPrice         Int?
  level            CourseLevel  @default(BEGINNER)
  format           CourseFormat @default(OFFLINE)
  skills           String[]
  /// [{ title: string, topics: string[] }]
  curriculum       Json         @default("[]")
  isPopular        Boolean      @default(false)
  isPublished      Boolean      @default(true)
  order            Int          @default(0)
  mentors          Mentor[]
  applications     Application[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([isPublished, order])
}

model Mentor {
  id              String   @id @default(cuid())
  fullName        String
  position        String
  bio             String?
  photo           String?
  experienceYears Int      @default(1)
  studentsCount   Int      @default(0)
  skills          String[]
  telegram        String?
  instagram       String?
  linkedin        String?
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  courses         Course[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, order])
}

// ─────────────────────────────────────────────
// Ijtimoiy isbot: bitiruvchilar fikri va hamkorlar
// ─────────────────────────────────────────────

model Testimonial {
  id          String   @id @default(cuid())
  fullName    String
  photo       String?
  courseName  String
  workplace   String?
  position    String?
  text        String
  rating      Int      @default(5)
  videoUrl    String?
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  website   String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Kontent: FAQ, filiallar, yangiliklar
// ─────────────────────────────────────────────

model Faq {
  id          String   @id @default(cuid())
  question    String
  answer      String
  isPublished Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Branch {
  id           String   @id @default(cuid())
  name         String
  address      String
  landmark     String?
  phone        String
  workingHours String   @default("Du–Sha: 09:00 – 21:00")
  mapUrl       String?
  image        String?
  isActive     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  cover       String?
  isPublished Boolean   @default(true)
  publishedAt DateTime  @default(now())
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

// ─────────────────────────────────────────────
// Arizalar (saytdan kelgan so'rovlar)
// ─────────────────────────────────────────────

model Application {
  id        String            @id @default(cuid())
  fullName  String
  phone     String
  message   String?
  status    ApplicationStatus @default(NEW)
  note      String?
  course    Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseId  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, createdAt])
}

// ─────────────────────────────────────────────
// Sayt sozlamalari (yagona yozuv, id = 1)
// ─────────────────────────────────────────────

model SiteSettings {
  id                Int      @id @default(1)
  heroBadge         String   @default("Yangi guruhlarga qabul ochiq")
  heroTitle         String   @default("Kelajak kasbini Joylinks bilan egallang")
  heroSubtitle      String   @default("Amaliyotga yo'naltirilgan IT kurslar, tajribali mentorlar va ishga joylashishda yordam.")
  phone             String   @default("+998 71 200 00 00")
  email             String   @default("info@joylinks.uz")
  address           String   @default("Toshkent sh.")
  telegram          String?
  instagram         String?
  youtube           String?
  facebook          String?
  graduatesCount    Int      @default(5000)
  employmentRate    Int      @default(87)
  mentorsCount      Int      @default(40)
  yearsOfExperience Int      @default(6)
  updatedAt         DateTime @updatedAt
}
